{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/catalogue(.html)?",
      "status": 301,
      "headers": {
        "Location": "/shop"
      }
    },
    {
      "src": "/shop",
      "dest": "/shop.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
