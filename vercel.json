{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    }
  ],
  "redirects": [
    {
      "source": "/catalogue",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/catalogue.html",
      "destination": "/shop",
      "permanent": true
    }
  ]
}
