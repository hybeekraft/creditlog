{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/catalogue(.html)?",
      "status": 301,
      "headers": {
        "Location": "/shop"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/shop",
      "dest": "/shop.html"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/inventory",
      "dest": "/inventory.html"
    },
    {
      "src": "/activity-logs",
      "dest": "/activity-logs.html"
    },
    {
      "src": "/checkout",
      "dest": "/checkout.html"
    },
    {
      "src": "/success",
      "dest": "/success.html"
    },
    {
      "src": "/product",
      "dest": "/product.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
