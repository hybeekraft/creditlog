{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": ".",
  "functions": {
    "api/*.js": {
      "includeFiles": "{data/**,style.css,shared.js,assets/**,*.html}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js?path=/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/catalogue",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/catalogue.html",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/server/:path*",
      "destination": "/404",
      "permanent": false
    },
    {
      "source": "/data/:path*",
      "destination": "/404",
      "permanent": false
    }
  ]
}
